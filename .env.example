# ==============================================================================
# INTALL ARCHITECTURAL STUDIO — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Copy this template to .env and configure your production or local secrets.
# Never commit .env containing actual secrets to version control.
# ==============================================================================

# Node Environment ('development' | 'production')
NODE_ENV=development

# Server Port (Default: 8000)
PORT=8000

# Canonical Public Application URL
# Used for absolute OAuth redirection & security origin validation.
# Local development: http://localhost:8000
# Production deployment: https://intall.in
APP_URL=http://localhost:8000

# Cryptographic Session Secret
# Used for server-side HMAC signatures and CSRF protection tokens.
# Generate a strong 32+ character random secret for production.
SESSION_SECRET=intall-drafting-cad-sec-token-9843210987654321

# ==============================================================================
# GOOGLE CLOUD CONSOLE OAUTH 2.0 CREDENTIALS
# ==============================================================================
# Complete setup instructions:
# 1. Navigate to Google Cloud Console: https://console.cloud.google.com/
# 2. Create or select a project (e.g., "INTALL Architectural CAD").
# 3. Configure the "OAuth consent screen":
#    - User Type: External
#    - App Name: INTALL Architectural Studio
#    - User support email & developer contact email
#    - Scopes: openid, https://www.googleapis.com/auth/userinfo.email, https://www.googleapis.com/auth/userinfo.profile
# 4. Navigate to "Credentials" -> "Create Credentials" -> "OAuth client ID":
#    - Application Type: Web application
#    - Name: INTALL Web Client
# 5. Authorized JavaScript origins:
#    - http://localhost:8000
#    - https://intall.in
# 6. Authorized redirect URIs:
#    - http://localhost:8000/auth/google/callback
#    - https://intall.in/auth/google/callback
# 7. Copy Client ID and Client Secret into the fields below:
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Allowed Redirect Target Whitelist (Prevents Open Redirect Vulnerabilities)
ALLOWED_REDIRECT_PATHS=/index.html,/home.html,/,/signin,/terms.html,/privacy.html
